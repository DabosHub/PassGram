# Copy to .env.local at the repo root (never commit .env.local).
# Next.js loads this file via frontend/next.config.ts.
# Never prefix secrets with NEXT_PUBLIC_.
#
# Deployer mnemonics belong ONLY in contract/.env (see contract/.env.example).

# --- Required for Postgres (app uses `pg` + DATABASE_URL) ---
# Supabase → Project Settings → Database → Connection string → URI (pooler, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Leave unset. Remote Postgres verifies its certificate. Set 1 only for a local proxy with a private certificate.
# PASSGRAM_DATABASE_SSL_NO_VERIFY=1

# Optional Supabase API keys (keep service role server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (server-only except bot username) ---
TELEGRAM_BOT_TOKEN=
PASSGRAM_BOT_USER_ID=
# Only A-Z a-z 0-9 _ - (Telegram secret_token rules)
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# BotFather Mini App short name used in t.me/<bot>/<short_name>?startapp=
NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=passgram
# Public https origin for setWebhook, e.g. https://your-app.vercel.app
PASSGRAM_PUBLIC_URL=
# Comma-separated Telegram user ids allowed to open /admin. Empty disables the console.
# Link the site domain to the bot with BotFather /setdomain so Telegram Login works there.
# PASSGRAM_ADMIN_TELEGRAM_IDS=
# Extra hosts that may prove a receiving wallet, comma-separated. passgram.app is always allowed.
# PASSGRAM_APP_DOMAINS=your-app.vercel.app

# Optional: force the local UI Lab on a non-localhost host (never enable on production Mini App)
# NEXT_PUBLIC_PASSGRAM_DEMO=1

# --- TON / USDT Jetton (Mini App, public) ---
NEXT_PUBLIC_TON_NETWORK=mainnet
# Mainnet jUSDT: EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Testnet USDTTT: kQD0GKBM8ZbryVk2aESmzfU6b9b_8era_IkvBSELujFZPsyy
NEXT_PUBLIC_USDT_JETTON=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Tolk 1.5.0 mainnet registry: EQCZ-KnsXQKxbCl0wlS9C_OcNQvPOdK-w9mYiRA_-kxy0uv6
NEXT_PUBLIC_PASSGRAM_REGISTRY=
# Must equal contract/registry.codehash: db8965a9ee8210beaa92285488794ba6cf39940dbf84c8ef17bfdba67c1c8961
# PASSGRAM_REGISTRY_CODE_HASH=
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=/tonconnect-manifest.json

# 32-byte ed25519 seed (64 hex chars) of the key stored as ownerPublicKey on the registry.
# RegisterCommunity is rejected unless this key signed every field stored for that community.
# A 128-hex secret key is also accepted; only its first 32 bytes are used. Never commit this.
# PASSGRAM_OWNER_SECRET=

# --- Optional public addresses (safe to set; no private keys) ---
# PASSGRAM_OWNER_ADDRESS=
# TREASURY_ADDRESS=

# --- bot-service only (do not expose to the browser) ---
# PASSGRAM_REGISTRY_ADDRESS=
# TON_API_URL=https://toncenter.com/api/v2
# TONCENTER_API_KEY=
# INDEXER_POLL_MS=15000
# CRON_INTERVAL_MS=60000

