# Copy to .env.local at the repo root (never commit .env.local).
# Next.js loads this file via frontend/next.config.ts.
# Never prefix secrets with NEXT_PUBLIC_.
#
# Deployer mnemonics belong ONLY in contract/.env (see contract/.env.example).

# --- Required for Postgres (app uses `pg` + DATABASE_URL) ---
# Supabase → Project Settings → Database → Connection string → URI (pooler, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Optional Supabase API keys (keep service role server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (server-only except bot username) ---
TELEGRAM_BOT_TOKEN=
PASSGRAM_BOT_USER_ID=
# Only A-Z a-z 0-9 _ - (Telegram secret_token rules)
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Public https origin for setWebhook, e.g. https://your-app.vercel.app
PASSGRAM_PUBLIC_URL=

# --- TON / USDT Jetton (Mini App, public) ---
NEXT_PUBLIC_TON_NETWORK=mainnet
# Mainnet jUSDT: EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Testnet USDTTT: kQD0GKBM8ZbryVk2aESmzfU6b9b_8era_IkvBSELujFZPsyy
NEXT_PUBLIC_USDT_JETTON=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
NEXT_PUBLIC_PASSGRAM_REGISTRY=
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=/tonconnect-manifest.json

# --- Optional public addresses (safe to set; no private keys) ---
# PASSGRAM_OWNER_ADDRESS=
# TREASURY_ADDRESS=

# --- bot-service only (do not expose to the browser) ---
# PASSGRAM_REGISTRY_ADDRESS=
# TON_API_URL=https://toncenter.com/api/v2
# TONCENTER_API_KEY=
# INDEXER_POLL_MS=15000
# CRON_INTERVAL_MS=60000

