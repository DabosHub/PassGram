# Copy to contract/.env — never commit secrets.

# 24-word mnemonic of the deployer wallet (testnet).
# Deploy stores this wallet's public key on the registry. The app server must hold the matching
# 32-byte seed in PASSGRAM_OWNER_SECRET (repo-root .env.local) so it can approve RegisterCommunity.
DEPLOYER_MNEMONIC=

# Optional overrides
# TREASURY_ADDRESS=
# Testnet USDTTT. Mainnet deploy uses jUSDT unless this is set to the mainnet master.
# USDT_JETTON_MASTER=kQD0GKBM8ZbryVk2aESmzfU6b9b_8era_IkvBSELujFZPsyy
# TONCENTER_API_KEY=
# Leave unset to use the API for DEPLOY_NETWORK. A testnet URL cannot deploy mainnet.
# TON_API_URL=https://testnet.toncenter.com/api/v2/jsonRPC
# DEPLOY_TON_AMOUNT=0.25
# GAS_RESERVE_TON=2
# Mainnet only, and only when you mean to publish this source:
# PASSGRAM_DEPLOY_MAINNET=1
