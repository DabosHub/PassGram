{
  "name": "passgram-contract",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "npx @ton/tolk-js --output-json build/tolk-registry.json contracts/passgram_registry.tolk",
    "test": "npm run build && node --test tests/split.test.mjs tests/codehash.test.mjs && node --import tsx --test tests/registry.sandbox.ts",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "test:testnet": "tsx scripts/test-registry-testnet.ts"
  },
  "dependencies": {
    "@ton/core": "^0.62.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.2.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.45.0",
    "@ton/test-utils": "^0.12.0",
    "@ton/tolk-js": "^1.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
